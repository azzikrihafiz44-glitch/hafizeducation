rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'jikikuki41@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidRoom(data) {
      return data.keys().hasAll(['code', 'title', 'questions', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'title', 'questions', 'ownerUid', 'status', 'category', 'openAt', 'closeAt', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 12 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 100
        && data.questions[0] is map
        && data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && (!('status' in data) || (data.status is string && data.status in ['waiting', 'started']))
        && (!('category' in data) || (data.category is string && data.category.size() <= 40))
        && (!('openAt' in data) || (data.openAt is string && data.openAt.size() <= 40))
        && (!('closeAt' in data) || (data.closeAt is string && data.closeAt.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistory(data) {
      return data.keys().hasAll([
          'roomCode', 'quizTitle', 'playerName', 'grade', 'points',
          'correctCount', 'totalQuestions', 'rank', 'certificateId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'quizTitle', 'playerName', 'grade', 'points',
          'correctCount', 'totalQuestions', 'rank', 'certificateId', 'createdAt'
        ])
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 && data.roomCode.matches('^[A-Z0-9_\\-]+$')
        && data.quizTitle is string && data.quizTitle.size() >= 1 && data.quizTitle.size() <= 200
        && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 60
        && data.grade is number && data.grade >= 0 && data.grade <= 100
        && data.points is number && data.points >= 0 && data.points <= 200000
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 200
        && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 200
        && data.correctCount <= data.totalQuestions
        && data.rank is number && data.rank >= 1 && data.rank <= 10000
        && data.certificateId is string && data.certificateId.size() >= 4 && data.certificateId.size() <= 40 && data.certificateId.matches('^[A-Z0-9\\-]+$')
        && data.createdAt is timestamp;
    }

    function isValidAdminDoc(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid == uid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp;
    }

    function isValidLobbyPlayer(data, playerId) {
      return data.keys().hasAll(['playerId', 'name', 'avatar', 'avatarLabel', 'joinedAt'])
        && data.keys().hasOnly(['playerId', 'name', 'avatar', 'avatarLabel', 'photoUrl', 'joinedAt'])
        && data.playerId is string && data.playerId == playerId && data.playerId.size() >= 4 && data.playerId.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.avatar is map
        && data.avatar.keys().hasOnly(['characterId', 'skinColor', 'hairId', 'topId', 'bottomId', 'shoeId', 'accessoryId'])
        && data.avatarLabel is string && data.avatarLabel.size() >= 1 && data.avatarLabel.size() <= 60
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.joinedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, uid) {
      return data.keys().hasAll([
          'uid', 'name', 'points', 'grade', 'correctCount',
          'totalQuestions', 'answeredCount', 'cheatCount', 'status', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'points', 'grade', 'correctCount',
          'totalQuestions', 'answeredCount', 'cheatCount', 'status', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.points is number && data.points >= 0 && data.points <= 200000
        && data.grade is number && data.grade >= 0 && data.grade <= 100
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 200
        && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 200
        && data.correctCount <= data.totalQuestions
        && data.answeredCount is number && data.answeredCount >= 0 && data.answeredCount <= data.totalQuestions
        && data.cheatCount is number && data.cheatCount >= 0 && data.cheatCount <= 500
        && data.status is string && data.status in ['playing', 'finished']
        && data.updatedAt is timestamp;
    }

    // --- Collection: /rooms/{roomCode} ---
    match /rooms/{roomCode} {
      // Public read so all visitors & students immediately see admin-uploaded quizzes, Try Outs & ASAS XII
      allow get: if isValidId(roomCode);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(roomCode)
        && isValidRoom(incoming())
        && incoming().code == roomCode
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(roomCode)
        && isValidRoom(incoming())
        && incoming().code == existing().code
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'questions', 'status', 'category', 'openAt', 'closeAt', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(roomCode);

      // --- Subcollection: /rooms/{roomCode}/players/{playerId} (Live Lobby Presence) ---
      match /players/{playerId} {
        allow get, list: if isSignedIn() && isValidId(roomCode);

        allow create: if isSignedIn()
          && isValidId(roomCode)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidLobbyPlayer(incoming(), playerId)
          && incoming().joinedAt == request.time;

        allow update: if isSignedIn()
          && isValidId(roomCode)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidLobbyPlayer(incoming(), playerId)
          && incoming().joinedAt == existing().joinedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'avatarLabel', 'photoUrl']);

        allow delete: if isSignedIn()
          && isValidId(roomCode)
          && isValidId(playerId)
          && (playerId == request.auth.uid || isAdmin());
      }

      // --- Subcollection: /rooms/{roomCode}/leaderboard/{uid} (Public Room Rankings for All Participants) ---
      match /leaderboard/{uid} {
        allow get, list: if isSignedIn() && isValidId(roomCode);

        allow create: if isSignedIn()
          && isValidId(roomCode)
          && isValidId(uid)
          && uid == request.auth.uid
          && isValidLeaderboardEntry(incoming(), uid)
          && incoming().updatedAt == request.time;

        allow update: if isSignedIn()
          && isValidId(roomCode)
          && isValidId(uid)
          && uid == request.auth.uid
          && isValidLeaderboardEntry(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time;

        allow delete: if isAdmin() && isValidId(roomCode) && isValidId(uid);
      }
    }

    // --- Collection: /history/{recordId} ---
    match /history/{recordId} {
      // Exact certificate lookup by ID for signed-in users or Admin
      allow get: if isSignedIn() && isValidId(recordId);
      // Full archive list strictly restricted to verified Admin
      allow list: if isAdmin();

      // Append-only quiz result submission restricted to authenticated participants
      allow create: if isSignedIn()
        && isValidId(recordId)
        && isValidHistory(incoming())
        && incoming().createdAt == request.time;

      // Immutable for students; only verified Admin can correct or delete
      allow update: if isAdmin()
        && isValidId(recordId)
        && isValidHistory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['playerName', 'rank']);

      allow delete: if isAdmin() && isValidId(recordId);
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'avatar', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'username', 'email', 'displayName', 'photoUrl', 'avatar',
          'school', 'phone', 'targetTrack', 'targetCampus',
          'authMethod', 'savedSkdSummary', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid && data.uid.size() <= 128
        && (!('username' in data) || (data.username is string && data.username.size() <= 40))
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 400000))
        && data.avatar is map
        && data.avatar.keys().hasOnly(['characterId', 'skinColor', 'hairId', 'topId', 'bottomId', 'shoeId', 'accessoryId'])
        && (!('school' in data) || (data.school is string && data.school.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 24))
        && (!('targetTrack' in data) || (data.targetTrack is string && data.targetTrack in ['utbk', 'kedinasan', 'both']))
        && (!('targetCampus' in data) || (data.targetCampus is string && data.targetCampus.size() <= 120))
        && (!('authMethod' in data) || (data.authMethod is string && data.authMethod in ['password', 'google', 'email']))
        && (!('savedSkdSummary' in data) || (
          data.savedSkdSummary is map
          && data.savedSkdSummary.keys().hasOnly(['twk', 'tiu', 'tkp', 'total', 'passedAllPg', 'recommendedSchool'])
        ))
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{uid} (Per-Participant Private Database) ---
    match /users/{uid} {
      allow get: if isValidId(uid) && ((isSignedIn() && request.auth.uid == uid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().updatedAt == request.time
        && ((isSignedIn() && request.auth.uid == uid && incoming().email == request.auth.token.email) || isAdmin());

      allow update: if isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (
            isSignedIn()
            && request.auth.uid == uid
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'displayName', 'photoUrl', 'avatar', 'school', 'phone',
              'targetTrack', 'targetCampus', 'authMethod', 'savedSkdSummary', 'updatedAt'
            ])
          )
          || isAdmin()
        );

      allow delete: if isAdmin() && isValidId(uid);

      // Personal Quiz & Certificate History per Participant
      match /history/{recordId} {
        allow get, list: if isValidId(uid) && ((isSignedIn() && request.auth.uid == uid) || isAdmin());

        allow create: if isSignedIn()
          && isValidId(uid)
          && isValidId(recordId)
          && request.auth.uid == uid
          && isValidHistory(incoming())
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isValidId(uid)
          && isValidId(recordId)
          && ((isSignedIn() && request.auth.uid == uid) || isAdmin());
      }
    }

    // --- Collection: /admins/{uid} ---
    match /admins/{uid} {
      // PII (email) isolated strictly to owner or bootstrapped admin
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminDoc(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['brandName', 'heroTagline', 'heroTitle', 'heroDescription', 'announcement', 'updatedAt'])
        && data.keys().hasOnly([
          'brandName', 'heroTagline', 'heroTitle', 'heroDescription',
          'announcement', 'founderPhoto', 'playStoreUrl', 'appStoreUrl',
          'microsoftStoreUrl', 'androidPackageId', 'iosBundleId', 'appleTeamId',
          'microsoftStoreId', 'microsoftAppGuid', 'updatedAt'
        ])
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 80
        && data.heroTagline is string && data.heroTagline.size() <= 160
        && data.heroTitle is string && data.heroTitle.size() >= 1 && data.heroTitle.size() <= 160
        && data.heroDescription is string && data.heroDescription.size() <= 400
        && data.announcement is string && data.announcement.size() <= 300
        && (!('founderPhoto' in data) || (data.founderPhoto is string && data.founderPhoto.size() <= 400000))
        && (!('playStoreUrl' in data) || (data.playStoreUrl is string && data.playStoreUrl.size() <= 400))
        && (!('appStoreUrl' in data) || (data.appStoreUrl is string && data.appStoreUrl.size() <= 400))
        && (!('microsoftStoreUrl' in data) || (data.microsoftStoreUrl is string && data.microsoftStoreUrl.size() <= 400))
        && (!('androidPackageId' in data) || (data.androidPackageId is string && data.androidPackageId.size() <= 120))
        && (!('iosBundleId' in data) || (data.iosBundleId is string && data.iosBundleId.size() <= 120))
        && (!('appleTeamId' in data) || (data.appleTeamId is string && data.appleTeamId.size() <= 20))
        && (!('microsoftStoreId' in data) || (data.microsoftStoreId is string && data.microsoftStoreId.size() <= 80))
        && (!('microsoftAppGuid' in data) || (data.microsoftAppGuid is string && data.microsoftAppGuid.size() <= 48))
        && data.updatedAt is timestamp;
    }

    // --- Collection: /settings/{settingId} (Public Site Branding & Live Web Updates by Admin) ---
    match /settings/{settingId} {
      allow get: if settingId == 'site';
      allow list: if isAdmin();

      allow create: if isAdmin()
        && settingId == 'site'
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && settingId == 'site'
        && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    function isValidMaterial(data, materialId) {
      return data.keys().hasAll(['id', 'portal', 'subject', 'title', 'summary', 'keyPoints', 'formulas', 'ownerUid', 'updatedAt'])
        && data.keys().hasOnly(['id', 'portal', 'grade', 'tkaTrack', 'subject', 'title', 'subtitle', 'readMinutes', 'summary', 'keyPoints', 'formulas', 'youtubeUrl', 'pptUrl', 'pptName', 'ownerUid', 'updatedAt'])
        && data.id is string && data.id == materialId && data.id.size() >= 3 && data.id.size() <= 80
        && data.portal is string && data.portal in ['utbk', 'tka', 'sma', 'kedinasan']
        && (!('grade' in data) || (data.grade is string && data.grade in ['X', 'XI', 'XII']))
        && (!('tkaTrack' in data) || (data.tkaTrack is string && data.tkaTrack in ['Saintek', 'Soshum']))
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 200))
        && (!('readMinutes' in data) || (data.readMinutes is number && data.readMinutes >= 1 && data.readMinutes <= 180))
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 4000
        && data.keyPoints is list && data.keyPoints.size() <= 40
        && data.formulas is list && data.formulas.size() <= 30
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 300))
        && (!('pptUrl' in data) || (data.pptUrl is string && data.pptUrl.size() <= 500))
        && (!('pptName' in data) || (data.pptName is string && data.pptName.size() <= 160))
        && data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.updatedAt is timestamp;
    }

    // --- Collection: /materials/{materialId} (Admin-Uploaded Study Modules for UTBK, TKA, Kelas X-XII, Kedinasan) ---
    match /materials/{materialId} {
      allow get, list: if true;

      allow create: if isAdmin()
        && isValidId(materialId)
        && isValidMaterial(incoming(), materialId)
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(materialId)
        && isValidMaterial(incoming(), materialId)
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(materialId);
    }

    function isValidLiveSession(data, sessionId) {
      return data.keys().hasAll(['id', 'title', 'tutorName', 'category', 'scheduleLabel', 'zoomUrl', 'isLive', 'ownerUid', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'tutorName', 'category', 'scheduleLabel', 'zoomUrl', 'isLive', 'ownerUid', 'updatedAt'])
        && data.id is string && data.id == sessionId && data.id.size() >= 3 && data.id.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.tutorName is string && data.tutorName.size() >= 1 && data.tutorName.size() <= 100
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.scheduleLabel is string && data.scheduleLabel.size() >= 1 && data.scheduleLabel.size() <= 100
        && data.zoomUrl is string && data.zoomUrl.size() >= 8 && data.zoomUrl.size() <= 500
        && data.isLive is bool
        && data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.updatedAt is timestamp;
    }

    // --- Collection: /liveSessions/{sessionId} (Admin-Only Zoom Live Teaching Sessions) ---
    match /liveSessions/{sessionId} {
      allow get, list: if true;

      allow create: if isAdmin()
        && isValidId(sessionId)
        && isValidLiveSession(incoming(), sessionId)
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(sessionId)
        && isValidLiveSession(incoming(), sessionId)
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(sessionId);
    }
  }
}
