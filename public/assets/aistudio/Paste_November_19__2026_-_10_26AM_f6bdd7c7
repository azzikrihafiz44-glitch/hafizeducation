<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hafiz Education - Platform Kuis Interaktif 3D & Sertifikat Digital</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    * { font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background: #060918; color: #f8fafc; overflow-x: hidden; min-height: 100vh; }
    .aurora-bg {
      position: fixed; inset: 0; z-index: -1;
      background:
        radial-gradient(circle at 12% 18%, rgba(99, 102, 241, 0.28) 0%, transparent 42%),
        radial-gradient(circle at 86% 16%, rgba(236, 72, 153, 0.22) 0%, transparent 40%),
        radial-gradient(circle at 52% 85%, rgba(16, 185, 129, 0.18) 0%, transparent 46%),
        linear-gradient(180deg, #060918 0%, #0b1128 50%, #070b1d 100%);
    }
    .grid-overlay {
      position: fixed; inset: 0; z-index: -1;
      background-image: linear-gradient(rgba(148, 163, 184, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px);
      background-size: 36px 36px; pointer-events: none;
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(148, 163, 184, 0.18);
      box-shadow: 0 20px 50px rgba(2, 6, 23, 0.55);
    }
    .hero-glow-card {
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.85), rgba(15, 23, 42, 0.92));
      border: 1px solid rgba(129, 140, 248, 0.35);
      box-shadow: 0 0 40px rgba(99, 102, 241, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }
    .btn-3d {
      transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 6px 0 rgba(15, 23, 42, 0.55), 0 12px 24px rgba(0, 0, 0, 0.35);
    }
    .btn-3d:hover:not(:disabled) { transform: translateY(-2px); }
    .btn-3d:active:not(:disabled) { transform: translateY(3px); box-shadow: 0 2px 0 rgba(15, 23, 42, 0.65); }
    .choice-card-0 { background: linear-gradient(135deg, rgba(225, 29, 72, 0.22), rgba(190, 18, 60, 0.35)); border-color: rgba(251, 113, 133, 0.45); }
    .choice-card-1 { background: linear-gradient(135deg, rgba(37, 99, 235, 0.22), rgba(29, 78, 216, 0.35)); border-color: rgba(96, 165, 250, 0.45); }
    .choice-card-2 { background: linear-gradient(135deg, rgba(217, 119, 6, 0.22), rgba(180, 83, 9, 0.35)); border-color: rgba(251, 191, 36, 0.45); }
    .choice-card-3 { background: linear-gradient(135deg, rgba(5, 150, 105, 0.22), rgba(4, 120, 87, 0.35)); border-color: rgba(52, 211, 153, 0.45); }
    .choice-card-4 { background: linear-gradient(135deg, rgba(147, 51, 234, 0.22), rgba(107, 33, 168, 0.35)); border-color: rgba(192, 132, 252, 0.45); }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); border-radius: 999px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(99, 102, 241, 0.55); border-radius: 999px; }
    @keyframes floatSlow { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-7px); } }
    .animate-float { animation: floatSlow 3.6s ease-in-out infinite; }
    #lobby-3d-container canvas { display: block; width: 100% !important; height: 100% !important; border-radius: 1.25rem; }
    .speech-bubble-3d { position: absolute; transform: translate(-50%, -100%); pointer-events: none; white-space: nowrap; z-index: 20; }
  </style>
</head>
<body class="selection:bg-indigo-500 selection:text-white">
  <div class="aurora-bg"></div>
  <div class="grid-overlay"></div>

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/75 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      <!-- Brand Logo (5x klik untuk akses rahasia Admin) -->
      <button type="button" id="brand-secret-trigger" class="flex items-center gap-3 text-left group focus:outline-none">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition">
          <span class="text-xl">🎓</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-base sm:text-lg tracking-tight bg-gradient-to-r from-white via-indigo-200 to-pink-200 bg-clip-text text-transparent">
              Hafiz Education
            </span>
            <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
              3D ARENA
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-none">Kuis Interaktif Multiplayer & E-Sertifikat</p>
        </div>
      </button>

      <!-- Action Controls -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button type="button" onclick="openTutorialModal()" class="px-3 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-xs sm:text-sm font-semibold text-sky-300 flex items-center gap-1.5 transition">
          <span>📘</span>
          <span class="hidden sm:inline">Tutorial Peserta</span>
          <span class="sm:hidden">Panduan</span>
        </button>

        <button type="button" onclick="openWardrobeModal()" class="px-3 py-2 rounded-xl bg-gradient-to-r from-pink-600/80 to-purple-600/80 hover:from-pink-500 hover:to-purple-500 border border-pink-400/30 text-xs sm:text-sm font-semibold text-white flex items-center gap-1.5 shadow-md transition">
          <span>👗</span>
          <span>Kostum 3D</span>
        </button>

        <!-- Portal Switcher: Tersembunyi dari Peserta Biasa -->
        <div id="admin-portal-nav-wrapper" class="hidden flex items-center p-1 rounded-xl bg-slate-900/90 border border-amber-500/40">
          <button type="button" id="portal-tab-student" onclick="switchToStudentPortal()" class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-extrabold transition">
            🎓 Peserta
          </button>
          <button type="button" id="portal-tab-admin" onclick="openAdminGate()" class="px-3 py-1.5 rounded-lg text-amber-300 hover:bg-slate-800 text-xs font-extrabold flex items-center gap-1 transition">
            <span>🛡️</span>
            <span>Portal Admin</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- VIEW 1: PORTAL PESERTA -->
    <section id="view-landing" class="space-y-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/15 border border-indigo-400/30 text-indigo-300 text-xs font-bold">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Lobi Kampus 3D Interaktif • Pilihan Ganda A–E + Pembahasan</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
            Belajar Seru & Kompetitif di
            <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
              Arena Kuis 3D Hafiz Education
            </span>
          </h1>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
            Dandani karakter 3D kamu dengan lebih dari <strong>145+ pilihan baju, rok, celana, gaya rambut, dan aksesoris</strong>, berinteraksi bersama teman di Lobi 3D, kerjakan kuis interaktif tanpa batas waktu panik, dan raih <strong>Sertifikat Digital HD</strong>!
          </p>

          <div class="grid grid-cols-3 gap-2.5 sm:gap-4">
            <div class="glass-card p-3 sm:p-4 rounded-2xl border-indigo-500/20">
              <div class="text-xl sm:text-2xl mb-1">👕</div>
              <p class="text-xs sm:text-sm font-bold text-white">1. Pilih Gaya 3D</p>
              <p class="text-[11px] text-slate-400 hidden sm:block">Karakter cewek, cowok & chibi lucu</p>
            </div>
            <div class="glass-card p-3 sm:p-4 rounded-2xl border-purple-500/20">
              <div class="text-xl sm:text-2xl mb-1">🔑</div>
              <p class="text-xs sm:text-sm font-bold text-white">2. Masuk Kode</p>
              <p class="text-[11px] text-slate-400 hidden sm:block">Gabung lobi & main bersama teman</p>
            </div>
            <div class="glass-card p-3 sm:p-4 rounded-2xl border-emerald-500/20">
              <div class="text-xl sm:text-2xl mb-1">🏆</div>
              <p class="text-xs sm:text-sm font-bold text-white">3. Podium & Sertifikat</p>
              <p class="text-[11px] text-slate-400 hidden sm:block">Nilai otomatis & unduh sertifikat</p>
            </div>
          </div>

          <!-- Join Card -->
          <div class="hero-glow-card p-5 sm:p-7 rounded-3xl space-y-5">
            <div class="flex items-center justify-between">
              <h2 class="text-lg sm:text-xl font-extrabold text-white flex items-center gap-2">
                <span>🚀</span> Masuk ke Room Kuis
              </h2>
              <button type="button" onclick="openWardrobeModal()" class="text-xs font-bold text-pink-300 hover:text-pink-200 underline underline-offset-4">
                Ganti Baju & Rambut →
              </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Nama Lengkap Peserta</label>
                <input type="text" id="input-player-name" maxlength="28" placeholder="Contoh: Aisyah Putri / Hafiz" class="w-full px-4 py-3.5 rounded-2xl bg-slate-900/90 border border-slate-700 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/30 outline-none text-white font-semibold placeholder:text-slate-500 transition" />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Kode Room Kuis</label>
                <input type="text" id="input-room-code" maxlength="8" placeholder="Contoh: HF882A" class="w-full px-4 py-3.5 rounded-2xl bg-slate-900/90 border border-slate-700 focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 outline-none text-white font-extrabold uppercase tracking-widest placeholder:text-slate-500 placeholder:font-normal placeholder:tracking-normal transition" />
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-1">
              <button type="button" onclick="joinQuizRoom()" class="btn-3d flex-1 py-4 px-6 rounded-2xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-500 hover:to-pink-500 text-white font-extrabold text-base flex items-center justify-center gap-2.5">
                <span>🎮</span>
                <span>Gabung Lobi 3D & Mulai</span>
              </button>
              <button type="button" onclick="openTutorialModal()" class="py-4 px-5 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-sm flex items-center justify-center gap-2 transition">
                <span>❓</span>
                <span>Cara Main</span>
              </button>
            </div>

            <div id="saved-room-banner" class="hidden p-3.5 rounded-2xl bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-between gap-3">
              <div class="text-xs">
                <span class="text-emerald-300 font-bold">Room Aktif Tersedia:</span>
                <span id="saved-room-title" class="text-white font-semibold ml-1"></span>
              </div>
              <button type="button" onclick="fillSavedRoomCode()" class="px-3 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs shrink-0 transition">
                Pakai Kode <span id="saved-room-code-badge"></span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right 3D Character Showcase Card -->
        <div class="lg:col-span-5">
          <div class="hero-glow-card p-5 sm:p-6 rounded-3xl relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="px-2.5 py-1 rounded-full bg-pink-500/20 border border-pink-400/30 text-pink-300 text-[11px] font-bold">
                  ✨ Karakter 3D Kamu
                </span>
                <h3 id="landing-avatar-label" class="text-base font-extrabold text-white mt-1.5">Gadis Pita Manis</h3>
              </div>
              <button type="button" onclick="randomizeAvatar()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-amber-300 flex items-center gap-1.5 transition" title="Acak Kostum">
                <span>🎲</span> Acak Gaya
              </button>
            </div>

            <div id="landing-avatar-preview" class="w-full h-72 sm:h-80 rounded-2xl bg-gradient-to-b from-indigo-950/80 via-slate-900/90 to-slate-950 border border-slate-700/70 relative overflow-hidden flex items-center justify-center"></div>

            <div class="mt-4 grid grid-cols-2 gap-2.5">
              <button type="button" onclick="openWardrobeModal()" class="btn-3d py-3 px-4 rounded-2xl bg-gradient-to-r from-pink-600 to-purple-600 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2">
                <span>👗</span> Lemari Kostum (145+)
              </button>
              <button type="button" onclick="previewLobbyDemo()" class="py-3 px-4 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sky-300 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition">
                <span>🏫</span> Lihat Lobi 3D
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 2: LOBI DUNIA KAMPUS 3D INTERAKTIF -->
    <section id="view-lobby" class="hidden space-y-5">
      <div class="glass-card p-4 sm:p-5 rounded-3xl flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-2xl">🏫</div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="lobby-quiz-title" class="text-lg sm:text-xl font-extrabold text-white">Lobi Kampus 3D</h2>
              <span class="px-3 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-extrabold tracking-wider">
                KODE: <span id="lobby-room-badge">------</span>
              </span>
            </div>
            <p class="text-xs text-slate-300 mt-0.5">
              Gunakan <strong class="text-indigo-300">WASD / Tombol Panah</strong> untuk berjalan, <strong class="text-pink-300">Spasi</strong> untuk melompat, atau kirim chat & emote ke teman!
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <button type="button" onclick="openWardrobeModal()" class="px-4 py-2.5 rounded-xl bg-pink-600/80 hover:bg-pink-500 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 transition">
            <span>👗</span> Ganti Kostum
          </button>
          <button type="button" onclick="startQuizFromLobby()" id="btn-lobby-start-quiz" class="btn-3d px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-slate-950 font-extrabold text-xs sm:text-sm flex items-center gap-2">
            <span>🚀</span> Mulai Kerjakan Kuis (<span id="lobby-q-count">0</span> Soal)
          </button>
          <button type="button" onclick="leaveLobby()" class="px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-rose-950/70 border border-slate-700 text-slate-300 hover:text-rose-300 font-bold text-xs sm:text-sm transition">
            Keluar
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <div class="lg:col-span-8 glass-card p-3 rounded-3xl relative">
          <div id="lobby-3d-container" class="w-full h-[380px] sm:h-[470px] rounded-2xl overflow-hidden relative bg-slate-950">
            <div id="lobby-bubbles-layer" class="absolute inset-0 pointer-events-none overflow-hidden"></div>
            <div id="lobby-zone-banner" class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
              <span class="px-3 py-1.5 rounded-xl bg-slate-950/75 backdrop-blur-md border border-slate-700/80 text-xs font-bold text-sky-300">
                📍 Plaza Utama Akademi Hafiz
              </span>
              <span id="lobby-action-feedback" class="hidden px-3 py-1.5 rounded-xl bg-amber-500/90 text-slate-950 text-xs font-extrabold shadow-lg">
                ✨ Aksi Seru!
              </span>
            </div>

            <div class="absolute bottom-3 left-3 flex items-center gap-1.5 bg-slate-950/75 backdrop-blur-md p-2 rounded-2xl border border-slate-800">
              <button type="button" onmousedown="setMoveKey('ArrowLeft', true)" onmouseup="setMoveKey('ArrowLeft', false)" ontouchstart="setMoveKey('ArrowLeft', true)" ontouchend="setMoveKey('ArrowLeft', false)" class="w-9 h-9 rounded-xl bg-slate-800 active:bg-indigo-600 text-white font-bold">◀</button>
              <div class="flex flex-col gap-1">
                <button type="button" onmousedown="setMoveKey('ArrowUp', true)" onmouseup="setMoveKey('ArrowUp', false)" ontouchstart="setMoveKey('ArrowUp', true)" ontouchend="setMoveKey('ArrowUp', false)" class="w-9 h-9 rounded-xl bg-slate-800 active:bg-indigo-600 text-white font-bold">▲</button>
                <button type="button" onmousedown="setMoveKey('ArrowDown', true)" onmouseup="setMoveKey('ArrowDown', false)" ontouchstart="setMoveKey('ArrowDown', true)" ontouchend="setMoveKey('ArrowDown', false)" class="w-9 h-9 rounded-xl bg-slate-800 active:bg-indigo-600 text-white font-bold">▼</button>
              </div>
              <button type="button" onmousedown="setMoveKey('ArrowRight', true)" onmouseup="setMoveKey('ArrowRight', false)" ontouchstart="setMoveKey('ArrowRight', true)" ontouchend="setMoveKey('ArrowRight', false)" class="w-9 h-9 rounded-xl bg-slate-800 active:bg-indigo-600 text-white font-bold">▶</button>
            </div>

            <div class="absolute bottom-3 right-3 flex flex-wrap justify-end gap-1.5 bg-slate-950/75 backdrop-blur-md p-2 rounded-2xl border border-slate-800">
              <button type="button" onclick="triggerPlayerEmote('jump')" class="px-2.5 py-1.5 rounded-xl bg-indigo-600/80 hover:bg-indigo-500 text-xs font-bold text-white">🦘 Lompat</button>
              <button type="button" onclick="triggerPlayerEmote('dance')" class="px-2.5 py-1.5 rounded-xl bg-pink-600/80 hover:bg-pink-500 text-xs font-bold text-white">💃 Joget</button>
              <button type="button" onclick="triggerPlayerEmote('wave')" class="px-2.5 py-1.5 rounded-xl bg-amber-500/80 hover:bg-amber-400 text-xs font-bold text-slate-950">👋 Sapa</button>
              <button type="button" onclick="triggerLobbyParty()" class="px-2.5 py-1.5 rounded-xl bg-emerald-500/80 hover:bg-emerald-400 text-xs font-bold text-slate-950">🎉 Pesta</button>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col gap-4">
          <div class="glass-card p-4 rounded-3xl">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-extrabold text-white flex items-center gap-2">
                <span>👥</span> Peserta di Lobi (<span id="lobby-online-count">1</span>)
              </h3>
              <span class="text-[11px] text-emerald-400 font-bold">● Live 3D</span>
            </div>
            <div id="lobby-players-list" class="space-y-2 max-h-36 overflow-y-auto custom-scrollbar pr-1"></div>
          </div>

          <div class="glass-card p-4 rounded-3xl flex-1 flex flex-col">
            <h3 class="text-sm font-extrabold text-white mb-2 flex items-center gap-2">
              <span>💬</span> Obrolan & Reaksi Lobi
            </h3>
            <div id="lobby-chat-messages" class="flex-1 min-h-[140px] max-h-48 overflow-y-auto custom-scrollbar space-y-2 p-2.5 rounded-2xl bg-slate-950/70 border border-slate-800 text-xs">
              <div class="text-slate-400 italic">Selamat datang di Lobi Kampus 3D! Karakter muncul saat peserta bergabung.</div>
            </div>

            <div class="flex flex-wrap gap-1.5 my-2">
              <button type="button" onclick="sendQuickChat('Halo semua! 👋')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-200">Halo semua! 👋</button>
              <button type="button" onclick="sendQuickChat('Siap juara 1! 🏆')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-200">Siap juara 1! 🏆</button>
              <button type="button" onclick="sendQuickChat('Keren kostumnya! ✨')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-200">Keren kostumnya! ✨</button>
            </div>

            <form onsubmit="handleLobbyChatSubmit(event)" class="flex gap-2">
              <input type="text" id="lobby-chat-input" maxlength="60" placeholder="Ketik pesan ke lobi..." class="flex-1 px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 focus:border-indigo-400 outline-none text-xs text-white" />
              <button type="submit" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition">Kirim</button>
            </form>
          </div>
        </div>
      </div>
    </section>

